{
  "name": "@tycho/forge",
  "version": "1.0.0",
  "description": "Multi-forge adapter: pull requests, issues, mirrors (Forgejo, GitHub, GitLab, Bitbucket)",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "dist/cli.js",
    "README.md",
    "README.fr.md"
  ],
  "author": "Quatrain Technologies",
  "copyright": "Quatrain Technologies",
  "license": "AGPL-3.0-only",
  "repository": "https://git.qtrn.io/tycho/tycho-forge",
  "publishConfig": {
    "registry": "https://qtrn.io/"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=bun --outfile dist/cli.js",
    "prepack": "bun run build",
    "test": "bun test",
    "dev": "bun run src/cli.ts"
  },
  "tycho": {
    "module": "forge",
    "commands": [
      "forge"
    ],
    "core": "^1.0.0",
    "trust": "official"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
